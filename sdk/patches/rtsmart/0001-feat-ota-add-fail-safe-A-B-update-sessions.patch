+    ret = rt_device_open(device, RT_DEVICE_OFLAG_RDWR);
+    if (ret != RT_EOK)
+        return -EIO;
+
+    access = fd->flags & O_ACCMODE;
+    if (access != O_WRONLY && access != O_RDWR)
+        return 0;
+
+    ret = rt_mutex_take(&g_ota_session_lock, RT_WAITING_FOREVER);
+    if (ret != RT_EOK) {
+        rt_device_close(device);
+        return -EIO;
+    }
+
+    if (g_ota_writer) {
+        rt_mutex_release(&g_ota_session_lock);
+        rt_device_close(device);
+        return -EBUSY;
+    }
 
     ota_kdctx_reset();
+    fd->pos = 0;
+    g_ota_writer = fd;
+    rt_mutex_release(&g_ota_session_lock);
+    return 0;
+}
 
