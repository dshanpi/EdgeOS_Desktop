+        if (!entry->offset ||
+            !ota_storage_range_valid(entry->offset, entry->size)) {
+            LOG_E("ota: invalid TOC range %.32s: off=0x%llx size=0x%llx",
+                  entry->name,
+                  (unsigned long long)entry->offset,
+                  (unsigned long long)entry->size);
+            return -RT_ERROR;
+        }
+
+        end = entry->offset + entry->size;
+        if (entry->offset < toc_end && K230_TOC_OFFSET < end) {
+            LOG_E("ota: TOC entry %.32s overlaps the TOC itself",
+                  entry->name);
+            return -RT_ERROR;
+        }
+
+        for (j = 0; j < i; j++) {
+            const struct ota_partition *other = &g_ota_toc.entries[j];
+            rt_uint64_t other_end = other->offset + other->size;
+
+            if (rt_strncmp(entry->name, other->name,
+                           sizeof(entry->name)) == 0) {
+                LOG_E("ota: duplicate TOC entry %.32s", entry->name);
+                return -RT_ERROR;
+            }
+            if (entry->offset < other_end && other->offset < end) {
+                LOG_E("ota: overlapping TOC ranges %.32s and %.32s",
+                      entry->name, other->name);
+                return -RT_ERROR;
+            }
+        }
+    }
+
+    return RT_EOK;
