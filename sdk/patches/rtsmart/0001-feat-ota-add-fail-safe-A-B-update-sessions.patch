+static rt_bool_t ota_meta_is_pending(const struct ota_slot_meta *meta)
+{
+    return meta && (meta->reserved & OTA_META_PENDING) != 0;
+}
+
+static rt_bool_t ota_meta_is_exhausted(const struct ota_slot_meta *meta)
+{
+    return ota_meta_is_pending(meta) &&
+           (meta->reserved & OTA_META_ATTEMPTS_MASK) == 0;
+}
+
+static rt_bool_t ota_meta_is_healthy(const struct ota_slot_meta *meta,
+                                     rt_bool_t valid)
+{
+    return valid && !ota_meta_is_exhausted(meta);
+}
+
+static char ota_meta_select_slot(const struct ota_slot_meta *meta_a,
+                                 rt_bool_t valid_a,
+                                 const struct ota_slot_meta *meta_b,
+                                 rt_bool_t valid_b)
+{
+    rt_bool_t healthy_a = ota_meta_is_healthy(meta_a, valid_a);
+    rt_bool_t healthy_b = ota_meta_is_healthy(meta_b, valid_b);
+
+    /* Legacy factory images have no metadata and boot slot A. Once either
+     * slot has metadata, never select an invalid or attempts-exhausted slot. */
+    if (!valid_a && !valid_b)
+        return 'A';
+    if (healthy_a && !healthy_b)
+        return 'A';
+    if (!healthy_a && healthy_b)
+        return 'B';
+    if (!healthy_a && !healthy_b)
+        return 0;
+
+    return meta_a->version >= meta_b->version ? 'A' : 'B';
+}
