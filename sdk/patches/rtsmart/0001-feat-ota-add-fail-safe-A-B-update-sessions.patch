+    if (rt_mutex_take(&g_ota_session_lock,
+                      RT_WAITING_FOREVER) != RT_EOK)
+        return -EIO;
+    ret = g_ota_writer == fd ? ota_storage_sync() : RT_EOK;
+    rt_mutex_release(&g_ota_session_lock);
+    return ret == RT_EOK ? 0 : -EIO;
+}
+
+static int ota_fops_lseek(struct dfs_fd *fd, off_t offset)
+{
+    int ret = -EINVAL;
+
+    if (!fd || offset < 0)
+        return -EINVAL;
+
+    if (rt_mutex_take(&g_ota_session_lock,
+                      RT_WAITING_FOREVER) != RT_EOK)
+        return -EIO;
+
+    if (g_ota_writer != fd) {
+        if (offset == 0)
+            ret = 0;
+    } else if ((rt_uint64_t)offset == g_kdctx.file_pos) {
+        ret = (int)offset;
+    }
+
+    rt_mutex_release(&g_ota_session_lock);
+    return ret;
+}
+
+static int ota_fops_ioctl(struct dfs_fd *fd, int cmd, void *args)
+{
+    struct ota_slot_meta meta_a;
+    struct ota_slot_meta meta_b;
+    rt_bool_t valid_a = RT_FALSE;
+    rt_bool_t valid_b = RT_FALSE;
+    char active;
+    rt_err_t ret = RT_EOK;
+
+    if (!fd)
+        return -EINVAL;
+    if (rt_mutex_take(&g_ota_session_lock,
+                      RT_WAITING_FOREVER) != RT_EOK)
+        return -EIO;
+
+    if (cmd == K230_OTA_IOCTL_ABORT_UPDATE) {
+        if (g_ota_writer != fd) {
+            ret = -RT_EINVAL;
+        } else {
+            LOG_I("ota: update session explicitly aborted");
+            g_ota_writer = RT_NULL;
+            ota_kdctx_reset();
+        }
+        goto out;
+    }
+
+    ret = ota_meta_read_slot('A', &meta_a, &valid_a);
+    if (ret != RT_EOK)
+        goto out;
+    ret = ota_meta_read_slot('B', &meta_b, &valid_b);
+    if (ret != RT_EOK)
+        goto out;
+
+    active = k230_atag_get_ota_slot();
+    if (active != 'A' && active != 'B')
+        active = ota_meta_select_slot(&meta_a, valid_a, &meta_b, valid_b);
+
+    switch (cmd) {
+    case K230_OTA_IOCTL_CONFIRM_BOOT:
+    {
+        struct ota_slot_meta *meta;
+        rt_bool_t valid;
+
+        if (active != 'A' && active != 'B') {
+            ret = -RT_ERROR;
+            break;
+        }
+        meta = active == 'A' ? &meta_a : &meta_b;
+        valid = active == 'A' ? valid_a : valid_b;
+        if (!valid) {
+            LOG_I("ota: initializing healthy metadata for slot %c", active);
+            ret = ota_meta_write_slot(active, 0, 0);
+        } else if (ota_meta_is_pending(meta)) {
+            LOG_I("ota: confirming healthy slot %c version=0x%x",
+                  active, meta->version);
+            ret = ota_meta_write_slot(active, meta->version, 0);
+        }
+        break;
+    }
+
+    case K230_OTA_IOCTL_GET_STATUS:
+    {
+        struct ota_user_status status;
+
+        if (!args) {
+            ret = -RT_EINVAL;
+            break;
+        }
+        rt_memset(&status, 0, sizeof(status));
+        status.version_a = valid_a ? meta_a.version : 0;
+        status.version_b = valid_b ? meta_b.version : 0;
+        status.valid_a = valid_a;
+        status.valid_b = valid_b;
+        status.pending_a = valid_a && ota_meta_is_pending(&meta_a);
+        status.pending_b = valid_b && ota_meta_is_pending(&meta_b);
+        status.attempts_a = valid_a ?
+            (meta_a.reserved & OTA_META_ATTEMPTS_MASK) : 0;
+        status.attempts_b = valid_b ?
+            (meta_b.reserved & OTA_META_ATTEMPTS_MASK) : 0;
+        status.active_slot = active;
+#if defined(RT_USING_LWP) && defined(RT_USING_USERSPACE)
+        ret = lwp_put_to_user_ex(args, &status, sizeof(status)) == 0 ?
+            RT_EOK : -RT_ERROR;
+#else
+        rt_memcpy(args, &status, sizeof(status));
+#endif
+        break;
+    }
+
+    default:
+        ret = -RT_ENOSYS;
+        break;
+    }
+
+out:
+    rt_mutex_release(&g_ota_session_lock);
+    return ret == RT_EOK ? 0 : -EIO;
+}
