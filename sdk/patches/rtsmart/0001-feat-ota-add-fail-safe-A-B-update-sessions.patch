diff --git a/kernel/bsp/maix3/board/k230_atag.c b/kernel/bsp/maix3/board/k230_atag.c
index a02e7b088e2bee3b4c403b3c39f2ac69068fd68a..5fc2b2aa2fa053e7b7bd425074edc34d4f8ecf25 100644
--- a/kernel/bsp/maix3/board/k230_atag.c
+++ b/kernel/bsp/maix3/board/k230_atag.c
@@ -59,9 +59,18 @@ static int parse_tag_k230_rtapp(const struct tag *tag)
 	return 0;
 }
 
+static int parse_tag_k230_ota_slot(const struct tag *tag)
+{
+	rt_uint32_t slot = tag->u.k230_ota_slot.slot;
+
+	g_atag_info.ota_slot = (slot == 'A' || slot == 'B') ? (char)slot : 0;
+	return 0;
+}
+
 __tagtable(ATAG_CORE, parse_tag_k230_core);
 __tagtable(ATAG_K230_DDR_SIZE, parse_tag_k230_ddr_size);
 __tagtable(ATAG_K230_RTAPP, parse_tag_k230_rtapp);
+__tagtable(ATAG_K230_OTA_SLOT, parse_tag_k230_ota_slot);
 
 static int parse_tag(const struct tag *tag)
 {
@@ -182,3 +191,10 @@ rt_bool_t k230_atag_get_rtapp_loadaddr(rt_uint64_t *addr)
 	return RT_TRUE;
 }
 
+char k230_atag_get_ota_slot(void)
+{
+	if (!g_atag_parsed && k230_atag_parse(NULL) != 0)
+		return 0;
+
+	return g_atag_info.ota_slot;
+}
