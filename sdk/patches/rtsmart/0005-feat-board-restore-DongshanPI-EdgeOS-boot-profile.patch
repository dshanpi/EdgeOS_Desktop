   rt_kprintf("\n#############SDK VERSION######################################\n");
+  rt_kprintf("System: %s\n", SYSTEM_VERSION_);
   rt_kprintf("SDK   : %s\n", SDK_VERSION_);
 #ifdef CONFIG_SDK_ENABLE_CANMV
   rt_kprintf("CanMV : %s\n", CANMV_VERSION_);
