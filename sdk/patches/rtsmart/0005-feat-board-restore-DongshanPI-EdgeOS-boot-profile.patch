+#ifdef DONGSHANPI_EDGEOS_BOOT
+static const char *dongshanpi_boot_mode_name(dongshanpi_boot_mode_t mode)
+{
+  return mode == DONGSHANPI_BOOT_MODE_DEVELOPER ? "Developer" : "AI";
+}
+
+static dongshanpi_boot_key_action_t dongshanpi_read_boot_keys(void)
+{
+  int key2_pressed_count = 0;
+  int key3_pressed_count = 0;
+  rt_bool_t key3_available = RT_TRUE;
+
+  if (kd_pin_mode(DONGSHANPI_DEVELOPER_KEY_PIN,
+                  GPIO_DM_INPUT_PULLUP) != RT_EOK) {
+    rt_kprintf("KEY2: failed to configure GPIO%d; force Developer mode\n",
+               DONGSHANPI_DEVELOPER_KEY_PIN);
+    return DONGSHANPI_BOOT_KEY_FORCE_DEVELOPER;
+  }
+
+  if (kd_pin_mode(DONGSHANPI_MODE_TOGGLE_KEY_PIN,
+                  GPIO_DM_INPUT_PULLUP) != RT_EOK) {
+    rt_kprintf("KEY3: failed to configure GPIO%d; mode switching disabled\n",
+               DONGSHANPI_MODE_TOGGLE_KEY_PIN);
+    key3_available = RT_FALSE;
+  }
+
+  for (int i = 0; i < DONGSHANPI_KEY_DEBOUNCE_SAMPLES; i++) {
+    if (kd_pin_read(DONGSHANPI_DEVELOPER_KEY_PIN) == GPIO_PV_LOW) {
+      key2_pressed_count++;
+    }
+    if (key3_available &&
+        kd_pin_read(DONGSHANPI_MODE_TOGGLE_KEY_PIN) == GPIO_PV_LOW) {
+      key3_pressed_count++;
+    }
+    rt_thread_mdelay(DONGSHANPI_KEY_SAMPLE_MS);
+  }
+
+  if (key2_pressed_count >= DONGSHANPI_KEY_DEBOUNCE_PRESS_COUNT) {
+    rt_kprintf("KEY2 pressed: force Developer mode for this boot\n");
+    return DONGSHANPI_BOOT_KEY_FORCE_DEVELOPER;
+  }
+
+  if (key3_pressed_count < DONGSHANPI_KEY_DEBOUNCE_PRESS_COUNT) {
+    return DONGSHANPI_BOOT_KEY_NONE;
+  }
+
+  rt_kprintf("KEY3 pressed: keep holding to switch the default boot mode\n");
+  for (int i = DONGSHANPI_KEY_DEBOUNCE_SAMPLES;
+       i < DONGSHANPI_KEY3_HOLD_SAMPLES; i++) {
+    if (kd_pin_read(DONGSHANPI_MODE_TOGGLE_KEY_PIN) != GPIO_PV_LOW) {
+      rt_kprintf("KEY3 released before 2 seconds: mode unchanged\n");
+      return DONGSHANPI_BOOT_KEY_NONE;
+    }
+    rt_thread_mdelay(DONGSHANPI_KEY_SAMPLE_MS);
+  }
+
+  rt_kprintf("KEY3 long press detected: toggle the default boot mode\n");
+  return DONGSHANPI_BOOT_KEY_TOGGLE_DEFAULT;
+}
+
+static int dongshanpi_read_boot_mode_file(
+    const char *path, dongshanpi_boot_mode_t *mode)
+{
+  char buffer[16];
+  int bytes_read;
+  int fd;
+
+  fd = open(path, O_RDONLY, 0);
+  if (fd < 0) {
+    return -RT_ERROR;
+  }
+
+  rt_memset(buffer, 0, sizeof(buffer));
+  bytes_read = read(fd, buffer, sizeof(buffer) - 1);
+  close(fd);
+  if (bytes_read <= 0) {
+    return -RT_ERROR;
+  }
+
+  while (bytes_read > 0 &&
+         (buffer[bytes_read - 1] == '\n' ||
+          buffer[bytes_read - 1] == '\r' ||
+          buffer[bytes_read - 1] == ' ' ||
+          buffer[bytes_read - 1] == '\t')) {
+    buffer[--bytes_read] = '\0';
+  }
+
+  if (rt_strcmp(buffer, "ai") == 0) {
+    *mode = DONGSHANPI_BOOT_MODE_AI;
+    return RT_EOK;
+  }
+  if (rt_strcmp(buffer, "developer") == 0) {
+    *mode = DONGSHANPI_BOOT_MODE_DEVELOPER;
+    return RT_EOK;
+  }
+
+  return -RT_ERROR;
+}
+
+static dongshanpi_boot_mode_t dongshanpi_load_default_boot_mode(void)
+{
+  dongshanpi_boot_mode_t mode;
+
+  if (!g_fs_mount_data_succ) {
+    rt_kprintf("/data is unavailable; default boot mode is AI\n");
+    return DONGSHANPI_BOOT_MODE_AI;
+  }
+
+  if (dongshanpi_read_boot_mode_file(DONGSHANPI_BOOT_MODE_PATH,
+                                     &mode) == RT_EOK) {
+    return mode;
+  }
+
+  if (dongshanpi_read_boot_mode_file(DONGSHANPI_BOOT_MODE_BACKUP_PATH,
+                                     &mode) == RT_EOK) {
+    /* A power loss may leave only the valid backup. Recover it in place. */
+    if ((access(DONGSHANPI_BOOT_MODE_PATH, F_OK) != 0 ||
+         unlink(DONGSHANPI_BOOT_MODE_PATH) == 0) &&
+        rename(DONGSHANPI_BOOT_MODE_BACKUP_PATH,
+               DONGSHANPI_BOOT_MODE_PATH) == 0) {
+      rt_kprintf("Recovered boot mode configuration from backup\n");
+    } else {
+      rt_kprintf("Using backup boot mode configuration\n");
+    }
+    return mode;
+  }
+
+  if (access(DONGSHANPI_BOOT_MODE_PATH, F_OK) == 0) {
+    rt_kprintf("Invalid boot mode configuration; default to AI\n");
+  } else {
+    rt_kprintf("Boot mode configuration not found; default to AI\n");
+  }
+  return DONGSHANPI_BOOT_MODE_AI;
+}
+
+static int dongshanpi_save_default_boot_mode(dongshanpi_boot_mode_t mode)
+{
+  const char *value = mode == DONGSHANPI_BOOT_MODE_DEVELOPER
+                    ? "developer\n" : "ai\n";
+  dongshanpi_boot_mode_t ignored_mode;
+  rt_bool_t backup_valid;
+  rt_bool_t main_exists;
+  rt_bool_t main_valid;
+  int total_written = 0;
+  int value_len = rt_strlen(value);
+  int fd;
+
+  if (!g_fs_mount_data_succ) {
+    rt_kprintf("Cannot save boot mode: /data is unavailable\n");
+    return -RT_ERROR;
+  }
+
+  fd = open(DONGSHANPI_BOOT_MODE_TEMP_PATH,
+            O_WRONLY | O_CREAT | O_TRUNC, 0644);
+  if (fd < 0) {
+    rt_kprintf("Failed to open boot mode temporary file\n");
+    return -RT_ERROR;
+  }
+
+  while (total_written < value_len) {
+    int written = write(fd, value + total_written,
+                        value_len - total_written);
+    if (written <= 0) {
+      break;
+    }
+    total_written += written;
+  }
+  if (total_written != value_len || fsync(fd) != 0) {
+    rt_kprintf("Failed to write boot mode configuration\n");
+    close(fd);
+    unlink(DONGSHANPI_BOOT_MODE_TEMP_PATH);
+    return -RT_ERROR;
+  }
+  close(fd);
+
+  /*
+   * ELM/FAT rename cannot replace an existing destination. Keep the last
+   * known-good file until the new main file has been committed.
+   */
+  main_exists = access(DONGSHANPI_BOOT_MODE_PATH, F_OK) == 0;
+  main_valid = dongshanpi_read_boot_mode_file(DONGSHANPI_BOOT_MODE_PATH,
+                                               &ignored_mode) == RT_EOK;
+  backup_valid = dongshanpi_read_boot_mode_file(
+                     DONGSHANPI_BOOT_MODE_BACKUP_PATH,
+                     &ignored_mode) == RT_EOK;
+
+  if (main_valid) {
+    if ((access(DONGSHANPI_BOOT_MODE_BACKUP_PATH, F_OK) == 0 &&
+         unlink(DONGSHANPI_BOOT_MODE_BACKUP_PATH) != 0) ||
+        rename(DONGSHANPI_BOOT_MODE_PATH,
+               DONGSHANPI_BOOT_MODE_BACKUP_PATH) != 0) {
+      rt_kprintf("Failed to back up the existing boot mode configuration\n");
+      unlink(DONGSHANPI_BOOT_MODE_TEMP_PATH);
+      return -RT_ERROR;
+    }
+    backup_valid = RT_TRUE;
+  } else if (main_exists && unlink(DONGSHANPI_BOOT_MODE_PATH) != 0) {
+    rt_kprintf("Failed to remove invalid boot mode configuration\n");
+    unlink(DONGSHANPI_BOOT_MODE_TEMP_PATH);
+    return -RT_ERROR;
+  } else if (!backup_valid) {
+    unlink(DONGSHANPI_BOOT_MODE_BACKUP_PATH);
+  }
+
+  if (rename(DONGSHANPI_BOOT_MODE_TEMP_PATH,
+             DONGSHANPI_BOOT_MODE_PATH) != 0) {
+    rt_kprintf("Failed to commit boot mode configuration\n");
+    unlink(DONGSHANPI_BOOT_MODE_TEMP_PATH);
+    if (backup_valid &&
+        access(DONGSHANPI_BOOT_MODE_PATH, F_OK) != 0 &&
+        rename(DONGSHANPI_BOOT_MODE_BACKUP_PATH,
+               DONGSHANPI_BOOT_MODE_PATH) != 0) {
+      rt_kprintf("Failed to restore the previous boot mode configuration\n");
+    }
+    return -RT_ERROR;
+  }
+
+  unlink(DONGSHANPI_BOOT_MODE_BACKUP_PATH);
+  return RT_EOK;
+}
+
+static pid_t dongshanpi_start_edgeos(void)
+{
+#ifdef CONFIG_SECURE_BOOT_FIRMWARE_ENABLE
+  rt_kprintf("EdgeOS filesystem launcher is unavailable under secure boot\n");
+  return -1;
+#else
+  static char launcher_path[] = DONGSHANPI_EDGEOS_LAUNCHER_PATH;
+  static char background[] = "&";
+  char *argv[] = {launcher_path, background, RT_NULL};
+  pid_t pid;
+
+  if (!g_fs_mount_sdcard_succ) {
+    rt_kprintf("/sdcard is unavailable; cannot start EdgeOS\n");
+    return -1;
+  }
+  if (access(launcher_path, F_OK) != 0) {
+    rt_kprintf(DONGSHANPI_EDGEOS_LAUNCHER_PATH " not found\n");
+    return -1;
+  }
+
+  rt_kprintf("Starting " DONGSHANPI_EDGEOS_LAUNCHER_PATH "\n");
+  pid = exec(launcher_path, 0, 2, argv);
+  if (pid <= 0) {
+    rt_kprintf("Failed to start EdgeOS (exec returned %d)\n", pid);
+    return -1;
+  }
+
+  rt_kprintf("EdgeOS launcher started (pid=%d)\n", pid);
+  return pid;
+#endif
+}
+#endif
