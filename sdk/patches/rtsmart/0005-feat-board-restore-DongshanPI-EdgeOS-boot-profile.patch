+      boot_mode = DONGSHANPI_BOOT_MODE_DEVELOPER;
+    } else if (boot_key_action == DONGSHANPI_BOOT_KEY_TOGGLE_DEFAULT) {
+      dongshanpi_boot_mode_t new_mode =
+          boot_mode == DONGSHANPI_BOOT_MODE_AI
+          ? DONGSHANPI_BOOT_MODE_DEVELOPER
+          : DONGSHANPI_BOOT_MODE_AI;
+
+      if (dongshanpi_save_default_boot_mode(new_mode) == RT_EOK) {
+        rt_kprintf("Default boot mode changed: %s -> %s\n",
+                   dongshanpi_boot_mode_name(boot_mode),
+                   dongshanpi_boot_mode_name(new_mode));
+        boot_mode = new_mode;
+      } else {
+        rt_kprintf("Default boot mode unchanged because saving failed\n");
+      }
+    }
+
+    rt_kprintf("Selected boot mode: %s\n",
+               dongshanpi_boot_mode_name(boot_mode));
+
+    if (boot_mode == DONGSHANPI_BOOT_MODE_AI) {
+      if (dongshanpi_start_edgeos() > 0) {
+        return 0;
+      }
+      rt_kprintf("EdgeOS AI mode unavailable; fallback to MicroPython\n");
+    }
+#endif
