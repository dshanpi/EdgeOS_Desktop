diff --git a/configs/k230_canmv_dongshanpi_edgeos_defconfig b/configs/k230_canmv_dongshanpi_edgeos_defconfig
new file mode 100644
index 0000000000000000000000000000000000000000..097765ce89d96be8aa4a4aa3173a81da931a9ff2
--- /dev/null
+++ b/configs/k230_canmv_dongshanpi_edgeos_defconfig
@@ -0,0 +1,41 @@
+CONFIG_BOARD_CONFIG_NAME="k230_canmv_dongshanpi_edgeos_defconfig"
+CONFIG_BOARD_K230_CANMV_DONGSHANPI=y
+CONFIG_BOARD_NAME="DshanPI_EdgeOS_Desktop"
+CONFIG_BOARD_GEN_IMAGE_CFG_FILE="genimage-sdcard-edgeos.cfg"
+CONFIG_BOARD_GEN_OTA_IMAGE_CFG_FILE="genimage-sdcard-edgeos-ota.cfg"
+# CONFIG_UBOOT_USE_PREBUILT is not set
+CONFIG_ENABLE_UVC_CAMERA=y
+CONFIG_MPP_ENABLE_CSI_DEV_0=y
+CONFIG_MPP_CSI_DEV0_POWER=11
+CONFIG_MPP_CSI_DEV0_RESET=53
+CONFIG_MPP_CSI_DEV0_MCLK_1=y
+# CONFIG_MPP_ENABLE_CSI_DEV_1 is not set
+CONFIG_MPP_ENABLE_CSI_DEV_2=y
+CONFIG_MPP_CSI_DEV2_RESET=21
+CONFIG_MPP_CSI_DEV2_I2C_DEV="i2c4"
+CONFIG_MPP_CSI_DEV2_MCLK_1=y
+CONFIG_MPP_ENABLE_SENSOR_GC2093=y
+CONFIG_MPP_SENSOR_GC2093_ON_CSI0_USE_CHIP_CLK=y
+CONFIG_MPP_SENSOR_GC2093_ON_CSI2_USE_CHIP_CLK=y
+CONFIG_MPP_ENABLE_SENSOR_OV5647=y
+CONFIG_MPP_SENSOR_OV5647_ON_CSI2_USE_CHIP_CLK=y
+CONFIG_MPP_ENABLE_SENSOR_OV13850=y
+CONFIG_MPP_ENABLE_DSI_HDMI=y
+CONFIG_MPP_DSI_HDMI_RESET_PIN=24
+CONFIG_MPP_ENABLE_DSI_LCD=y
+CONFIG_MPP_DSI_LCD_RESET_PIN=22
+CONFIG_MPP_DSI_ENABLE_HDMI_LT9611=y
+CONFIG_MPP_DSI_ENABLE_LCD_ST7701=y
+CONFIG_MPP_DSI_ENABLE_LCD_ILI9806=y
+CONFIG_OPENSBI_USE_PREBUILT_FW_JUMP=y
+CONFIG_SDK_ENABLE_CANMV=y
+CONFIG_CANMV_OPENMV_CFG_FB_ALLOC_SIZE=0x1400000
+CONFIG_CANMV_OPENMV_CFG_FB_ALLOC_COUNT=640
+# EdgeOS does not use the optional CanMV WebRTC/libpeer module.
+# CONFIG_ENABLE_MODULE_WEBRTC is not set
+CONFIG_APP_ENABLE_LVGL_LAUNCHER=y
+CONFIG_RTSMART_3RD_PARTY_ALLOW_LVGL_WITH_CANMV=y
+CONFIG_RTSMART_3RD_PARTY_ENABLE_LVGL=y
+CONFIG_RTSMART_3RD_PARTY_ENABLE_CJSON=y
+CONFIG_RT_PARTITION_NUMBER=4
+CONFIG_RT_AUTO_RESIZE_PARTITION_ALWAYS=y
