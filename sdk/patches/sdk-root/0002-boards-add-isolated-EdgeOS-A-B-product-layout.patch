From e01e4b196b4854bd11ceda5f5d079fcdd4777a0c Mon Sep 17 00:00:00 2001
From: Ubuntu <ubuntu@ubuntu2004.linuxvmimages.local>
Date: Mon, 24 Aug 2026 00:05:38 -0400
Subject: [PATCH 2/2] boards: add isolated EdgeOS A/B product layout

---
 .../genimage-sdcard-edgeos-ota.cfg            |  41 +++++++
 .../genimage-sdcard-edgeos.cfg                | 116 ++++++++++++++++++
 .../k230_canmv_dongshanpi/system-version.txt  |   1 +
 configs/defconfig_info                        |   1 +
 .../k230_canmv_dongshanpi_edgeos_defconfig    |  41 +++++++
 src/rtsmart/Kconfig                           |   2 +-
 6 files changed, 201 insertions(+), 1 deletion(-)
 create mode 100644 boards/k230_canmv_dongshanpi/genimage-sdcard-edgeos-ota.cfg
 create mode 100644 boards/k230_canmv_dongshanpi/genimage-sdcard-edgeos.cfg
 create mode 100644 boards/k230_canmv_dongshanpi/system-version.txt
 create mode 100644 configs/k230_canmv_dongshanpi_edgeos_defconfig

diff --git a/boards/k230_canmv_dongshanpi/genimage-sdcard-edgeos-ota.cfg b/boards/k230_canmv_dongshanpi/genimage-sdcard-edgeos-ota.cfg
new file mode 100644
index 0000000000000000000000000000000000000000..737f53e7c844054d35a79a90a00593bac0207159
--- /dev/null
+++ b/boards/k230_canmv_dongshanpi/genimage-sdcard-edgeos-ota.cfg
@@ -0,0 +1,41 @@
+image app-ota.vfat {
+	vfat {
+		label = "APP_OTA"
+		extraargs = " -F 32 -s 2 "
+	}
+	size = 512M
+	temporary = true
+	mountpoint = "sdcard"
+}
+
+image sysimage-sdcard-ota.kdimg {
+	kdimage {
+		image_info = "edgeos_ota_rtt_rtapp_app"
+		chip_info = "none"
+		board_info = "none"
+		partition-table-type = "none"
+	}
+
+	# Offsets are package-local. RT-Smart writes each named payload to the
+	# matching partition in the inactive slot.
+	partition rtt {
+		in-partition-table = false
+		offset = 10M
+		size = 20M
+		image = "opensbi/opensbi_rtt_system.bin"
+	}
+
+	partition rtapp {
+		in-partition-table = false
+		offset = 30M
+		size = 20M
+		image = "rtapp/rtapp.elf.gz"
+	}
+
+	partition app {
+		in-partition-table = false
+		offset = 50M
+		size = 512M
+		image = "app-ota.vfat"
+	}
+}
diff --git a/boards/k230_canmv_dongshanpi/genimage-sdcard-edgeos.cfg b/boards/k230_canmv_dongshanpi/genimage-sdcard-edgeos.cfg
new file mode 100644
index 0000000000000000000000000000000000000000..c45ec8e6b34980a9008be6267cab6a2789e14ba1
--- /dev/null
+++ b/boards/k230_canmv_dongshanpi/genimage-sdcard-edgeos.cfg
@@ -0,0 +1,116 @@
+image bin.vfat {
+	vfat {
+		label = "BIN"
+		extraargs = " -F 16 -s 64 "
+	}
+	size = 20M
+	temporary = true
+	mountpoint = "bin"
+}
+
+image app-a.vfat {
+	vfat {
+		label = "APP_A"
+		extraargs = " -F 32 -s 2 "
+	}
+	size = 512M
+	temporary = true
+	mountpoint = "sdcard"
+}
+
+image app-b.vfat {
+	vfat {
+		label = "APP_B"
+		extraargs = " -F 32 -s 2 "
+	}
+	size = 512M
+	temporary = true
+	mountpoint = "sdcard"
+}
+
+image sysimage-sdcard.img {
+	hdimage {
+		toc = true
+		toc-offset = 0xe0000
+		partition-table-type = "mbr"
+	}
+
+	partition ota_meta {
+		in-partition-table = false
+		offset = 0xf0000
+		size = 0x800
+	}
+
+	partition spl {
+		in-partition-table = false
+		offset = 0x100000
+		image = "uboot/fn_u-boot-spl.bin"
+	}
+
+	partition uboot_env {
+		in-partition-table = false
+		offset = 0x1e0000
+		size = 0x10000
+		image = "uboot/env.bin"
+	}
+
+	partition uboot {
+		in-partition-table = false
+		offset = 0x200000
+		image = "uboot/fn_ug_u-boot.bin"
+	}
+
+	partition rtt_a {
+		in-partition-table = false
+		offset = 10M
+		size = 20M
+		image = "opensbi/opensbi_rtt_system.bin"
+		load = true
+		boot = 0x3
+	}
+
+	partition rtapp_a {
+		in-partition-table = false
+		offset = 30M
+		size = 30M
+		image = "rtapp/rtapp.elf.gz"
+		load = true
+	}
+
+	partition rtt_b {
+		in-partition-table = false
+		offset = 60M
+		size = 20M
+		image = "opensbi/opensbi_rtt_system.bin"
+		load = true
+		boot = 0x3
+	}
+
+	partition rtapp_b {
+		in-partition-table = false
+		offset = 80M
+		size = 30M
+		image = "rtapp/rtapp.elf.gz"
+		load = true
+	}
+
+	partition bin {
+		partition-type = 0xc
+		offset = 110M
+		image = "bin.vfat"
+	}
+
+	# Keep both application slots explicit. The factory image initializes the
+	# slots with identical contents; OTA only writes the inactive slot.
+	partition app_a {
+		partition-type = 0xc
+		offset = 130M
+		image = "app-a.vfat"
+	}
+
+	partition app_b {
+		partition-type = 0xc
+		offset = 642M
+		image = "app-b.vfat"
+	}
+}
