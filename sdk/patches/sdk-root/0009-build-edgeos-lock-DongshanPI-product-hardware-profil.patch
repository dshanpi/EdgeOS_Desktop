From 1430be9547aa4aaf93886b2a893bc1392d7951ff Mon Sep 17 00:00:00 2001
From: DshanPI EdgeOS SDK <sdk@dshanpi.com>
Date: Mon, 24 Aug 2026 06:04:03 -0400
Subject: [PATCH 09/10] build(edgeos): lock DongshanPI product hardware profile

---
 configs/k230_canmv_dongshanpi_edgeos_defconfig | 13 ++++++++++++-
 src/applications/apps.mk                       |  1 +
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/configs/k230_canmv_dongshanpi_edgeos_defconfig b/configs/k230_canmv_dongshanpi_edgeos_defconfig
index 097765c..d8602f5 100644
--- a/configs/k230_canmv_dongshanpi_edgeos_defconfig
+++ b/configs/k230_canmv_dongshanpi_edgeos_defconfig
@@ -5,12 +5,17 @@ CONFIG_BOARD_GEN_IMAGE_CFG_FILE="genimage-sdcard-edgeos.cfg"
 CONFIG_BOARD_GEN_OTA_IMAGE_CFG_FILE="genimage-sdcard-edgeos-ota.cfg"
 # CONFIG_UBOOT_USE_PREBUILT is not set
 CONFIG_ENABLE_UVC_CAMERA=y
+CONFIG_ENABLE_NETWORK_RT_WLAN=y
+CONFIG_RTSMART_CONFIG_FILE="k230_canmv_dongshanpi_edgeos"
+CONFIG_MPP_DEFAULT_SENSOR_CSI_0=y
 CONFIG_MPP_ENABLE_CSI_DEV_0=y
 CONFIG_MPP_CSI_DEV0_POWER=11
 CONFIG_MPP_CSI_DEV0_RESET=53
+CONFIG_MPP_CSI_DEV0_I2C_DEV="i2c0"
 CONFIG_MPP_CSI_DEV0_MCLK_1=y
 # CONFIG_MPP_ENABLE_CSI_DEV_1 is not set
 CONFIG_MPP_ENABLE_CSI_DEV_2=y
+CONFIG_MPP_CSI_DEV2_POWER=-1
 CONFIG_MPP_CSI_DEV2_RESET=21
 CONFIG_MPP_CSI_DEV2_I2C_DEV="i2c4"
 CONFIG_MPP_CSI_DEV2_MCLK_1=y
@@ -22,8 +27,10 @@ CONFIG_MPP_SENSOR_OV5647_ON_CSI2_USE_CHIP_CLK=y
 CONFIG_MPP_ENABLE_SENSOR_OV13850=y
 CONFIG_MPP_ENABLE_DSI_HDMI=y
 CONFIG_MPP_DSI_HDMI_RESET_PIN=24
+CONFIG_MPP_DSI_HDMI_I2C_DEV="i2c3"
 CONFIG_MPP_ENABLE_DSI_LCD=y
 CONFIG_MPP_DSI_LCD_RESET_PIN=22
+CONFIG_MPP_DSI_LCD_BACKLIGHT_PIN=25
 CONFIG_MPP_DSI_ENABLE_HDMI_LT9611=y
 CONFIG_MPP_DSI_ENABLE_LCD_ST7701=y
 CONFIG_MPP_DSI_ENABLE_LCD_ILI9806=y
@@ -33,9 +40,13 @@ CONFIG_CANMV_OPENMV_CFG_FB_ALLOC_SIZE=0x1400000
 CONFIG_CANMV_OPENMV_CFG_FB_ALLOC_COUNT=640
 # EdgeOS does not use the optional CanMV WebRTC/libpeer module.
 # CONFIG_ENABLE_MODULE_WEBRTC is not set
-CONFIG_APP_ENABLE_LVGL_LAUNCHER=y
+CONFIG_APP_ENABLE_EDGEOS_DESKTOP=y
 CONFIG_RTSMART_3RD_PARTY_ALLOW_LVGL_WITH_CANMV=y
 CONFIG_RTSMART_3RD_PARTY_ENABLE_LVGL=y
+# VG-Lite currently corrupts memory on the K230 EdgeOS display path.  Keep the
+# verified software renderer explicit because the SDK Kconfig defaults to yes.
+# CONFIG_RTSMART_3RD_PARTY_LVGL_USE_VGLITE is not set
+# CONFIG_RTSMART_HAL_ENABLE_VG_LITE is not set
 CONFIG_RTSMART_3RD_PARTY_ENABLE_CJSON=y
 CONFIG_RT_PARTITION_NUMBER=4
 CONFIG_RT_AUTO_RESIZE_PARTITION_ALWAYS=y
diff --git a/src/applications/apps.mk b/src/applications/apps.mk
index 860f634..dd1fb01 100644
--- a/src/applications/apps.mk
+++ b/src/applications/apps.mk
@@ -1,3 +1,4 @@
 -include $(SDK_SRC_ROOT_DIR)/.config
 
 subdirs-$(CONFIG_APP_ENABLE_HELLOWORLD) += helloworld
+subdirs-$(CONFIG_APP_ENABLE_EDGEOS_DESKTOP) += EdgeOS_Desktop
-- 
2.25.1

