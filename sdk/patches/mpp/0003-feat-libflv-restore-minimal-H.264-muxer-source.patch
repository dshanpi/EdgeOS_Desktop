+	struct mpeg4_avc_t avc;
+	memset(&avc, 0, sizeof(avc));
+
+	h264_annexbtomp4(&avc, sps, sizeof(sps), buffer, sizeof(buffer), &vcl, &update);
+	assert(0 == vcl && 1 == update);
