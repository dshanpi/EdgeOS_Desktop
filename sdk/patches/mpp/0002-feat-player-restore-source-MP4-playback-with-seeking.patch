diff --git a/middleware/src/mp4_format/src/mp4_format.cc b/middleware/src/mp4_format/src/mp4_format.cc
index fb38994f769948a2365233b93212a8d6bccd73f5..db7b8d2f9d6dab1c409e3b7b3decd36c433a0fec 100644
--- a/middleware/src/mp4_format/src/mp4_format.cc
+++ b/middleware/src/mp4_format/src/mp4_format.cc
@@ -1387,3 +1387,53 @@ int kd_mp4_get_frame(KD_HANDLE mp4_handle, k_mp4_frame_data_s *frame_data)
     av_packet_free(&pkt);
     return 0;
 }
+
+int kd_mp4_seek(KD_HANDLE mp4_handle, uint64_t *timestamp_ms)
+{
+    if (!mp4_handle || !timestamp_ms) return -1;
+
+    Mp4DemuxerCtx *ctx = static_cast<Mp4DemuxerCtx*>(mp4_handle);
+    if (!ctx->format_ctx || !ctx->format_ctx->iformat) return -1;
+
+    uint64_t target_ms = *timestamp_ms;
+    if (ctx->format_ctx->duration != AV_NOPTS_VALUE &&
+        ctx->format_ctx->duration > 0) {
+        const uint64_t duration_ms =
+            static_cast<uint64_t>(ctx->format_ctx->duration) / 1000;
+        if (target_ms > duration_ms) target_ms = duration_ms;
+    }
+
+    int stream_idx = -1;
+    for (const auto &track : ctx->tracks) {
+        if (track.track_type == K_MP4_STREAM_VIDEO) {
+            stream_idx = track.stream_idx;
+            break;
+        }
+    }
+
+    int64_t target;
+    if (stream_idx >= 0) {
+        AVStream *stream = ctx->format_ctx->streams[stream_idx];
+        target = av_rescale_q(static_cast<int64_t>(target_ms),
+                              av_make_q(1, 1000), stream->time_base);
+    } else {
+        target = av_rescale_q(static_cast<int64_t>(target_ms),
+                              av_make_q(1, 1000), AV_TIME_BASE_Q);
+    }
+
+    const int ret = av_seek_frame(ctx->format_ctx, stream_idx, target,
+                                  AVSEEK_FLAG_BACKWARD);
+    if (ret < 0) {
+        std::cerr << "[mp4_format] seek failed: " << ff_error_str(ret)
+                  << std::endl;
+        return -1;
+    }
+
+    avformat_flush(ctx->format_ctx);
+    if (ctx->h264_bsf_ctx) av_bsf_flush(ctx->h264_bsf_ctx);
+    if (ctx->hevc_bsf_ctx) av_bsf_flush(ctx->hevc_bsf_ctx);
+    ctx->frame_buffer.clear();
+    ctx->eof_reached = false;
+    *timestamp_ms = target_ms;
+    return 0;
+}
