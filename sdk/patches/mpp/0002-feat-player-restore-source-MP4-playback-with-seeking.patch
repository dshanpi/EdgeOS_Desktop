+    (void)blk_size;
+
+    handle = kd_mpi_vb_phyaddr_to_handle(phys_addr);
+    if(handle == VB_INVALID_HANDLE) {
+        printf("kd_mpi_vb_phyaddr_to_handle failed\n");
