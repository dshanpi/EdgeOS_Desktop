+    k_u64  cur_time;            /**< current position in milliseconds */
+}K_PLAYER_PROGRESS_INFO;
+
+typedef k_s32 (*K_PLAYER_EVENT_FN)(K_PLAYER_EVENT_E enEvent, void* pData);
