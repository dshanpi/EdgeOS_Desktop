+k_s32 disp_play(k_u8*pdata,k_u32 len,k_u64 timestamp,k_bool end_stream)
+{
+    k_s32 ret;
+    sample_vdec_conf_t *vdec_conf;
+    k_vdec_stream stream;
+    vdec_conf = &g_vdec_conf[0];
+    int poolid = vdec_conf->input_pool_id;
+    k_u64 phys_addr = 0;
+    k_u8 *virt_addr;
+    k_u32 blk_size;
+
+    blk_size = len;
+
+    if (g_vdec_first_stream && !end_stream)
+    {
+        printf("VDEC: first stream pts=%llu, size=%u\n",
+               (unsigned long long)timestamp, len);
+        g_vdec_first_stream = K_FALSE;
+    }
+
+    for (int retry = 0; retry < 100; retry++)
+    {
+        ret = kd_sample_sys_get_vb_block_from_pool_id(poolid, &phys_addr, blk_size, NULL);
+        if (K_SUCCESS != ret)
+        {
+            usleep(30000);
+            continue;
+        }
+        break;
+    }
+    if (phys_addr == 0)
+    {
+        printf("kd_sample_sys_get_vb_block_from_pool_id timeout\n");
+        return K_FAILED;
+    }
+
+    vdec_conf->pool_id = poolid;
+    virt_addr = (unsigned char*)_sys_mmap(phys_addr, blk_size);
+    if (virt_addr == NULL)
+    {
+        kd_sample_sys_release_vb_block(phys_addr, blk_size);
+        return K_FAILED;
+    }
+
+    memcpy(virt_addr,pdata,len);
+    stream.phy_addr = phys_addr;
+    stream.len = len;
+    stream.pts = timestamp;
+    stream.end_of_stream = end_stream;
+
+    ret = kd_mpi_vdec_send_stream(0, &stream, -1);
+    if (K_SUCCESS != ret)
+    {
+        printf("kd_mpi_vdec_send_stream failed\n");
+        _sys_munmap(phys_addr, virt_addr, blk_size);
+        kd_sample_sys_release_vb_block(phys_addr, blk_size);
+        return K_FAILED;
+    }
+    _sys_munmap(phys_addr, virt_addr, blk_size);
+    ret = kd_sample_sys_release_vb_block(phys_addr, blk_size);
+    if (K_SUCCESS != ret)
+    {
+        printf("kd_sample_sys_release_vb_block failed\n");
+        return K_FAILED;
+    }
+
+    if(end_stream)
+    {
+        // check vdec over
+        k_vdec_chn_status status;
+        int eos_wait;
+        for (eos_wait = 0; eos_wait < 2000; ++eos_wait)
+        {
+            ret = kd_mpi_vdec_query_status(vdec_conf->ch_id, &status);
+            if (K_SUCCESS != ret)
+            {
+                printf("kd_mpi_vdec_query_status failed\n");
+                break;
+            }
+
+            if (status.end_of_stream)
+            {
+                printf("%s>ch %d, receive eos\n", __func__, vdec_conf->ch_id);
+                break;
+            }
+            usleep(1000);
+        }
+        if (eos_wait == 2000)
+            printf("disp_play: VDEC EOS wait timed out\n");
+    }
+
+    return K_SUCCESS;
+}
+
+k_s32 disp_close()
+{
+    int ch = 0;
+    k_s32 result = K_SUCCESS;
+    if (g_vdec_vo_bound &&
+        K_SUCCESS != kd_sample_vdec_unbind_vo(ch, 0, BIND_VO_LAYER))
+    {
+        printf("kd_sample_vdec_unbind_vo failed\n");
+        result = K_FAILED;
+    }
+    g_vdec_vo_bound = K_FALSE;
+
+    if (g_vdec_channel_started && K_SUCCESS != kd_mpi_vdec_stop_chn(ch))
+    {
+        printf("kd_mpi_vdec_stop_chn failed\n");
+        result = K_FAILED;
+    }
+    g_vdec_channel_started = K_FALSE;
+
+    if (g_vdec_pool_attached && K_SUCCESS != kd_mpi_vdec_detach_vb_pool(ch))
+    {
+        printf("kd_mpi_vdec_detach_vb_pool failed\n");
+        result = K_FAILED;
+    }
+    g_vdec_pool_attached = K_FALSE;
+
+    if (g_vdec_channel_created && K_SUCCESS != kd_mpi_vdec_destroy_chn(ch))
+    {
+        printf("kd_mpi_vdec_destroy_chn failed\n");
+        result = K_FAILED;
+    }
+    g_vdec_channel_created = K_FALSE;
+
+    if (g_vdec_layer_initialized)
+        display_layer_deinit();
+    g_vdec_layer_initialized = K_FALSE;
+
+    if (g_vdec_pools_created && vb_destory_pool(0) != K_SUCCESS)
+    {
+        printf("vb_destory_pool error");
+        result = K_FAILED;
+    }
+    g_vdec_first_stream = K_FALSE;
+
+    return result;
+}
