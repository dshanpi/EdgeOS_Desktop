+static struct k230_toc_entry *k230_find_toc_entry(const char *name)
+{
+	for (int i = 0; i < toc.entry_count; i++) {
+		if (!strncmp(toc.entries[i].name, name,
+			     sizeof(toc.entries[i].name)))
+			return &toc.entries[i];
+	}
+
+	return NULL;
+}
+
+static int k230_get_ota_meta_offset(char slot, ulong *offset)
+{
+	struct k230_toc_entry *entry;
+	uint64_t span;
+	uint64_t selected;
+
+	if (!offset || (slot != 'A' && slot != 'B'))
+		return -1;
+	entry = k230_find_toc_entry("ota_meta");
+	if (!entry)
+		return -1;
+
+	span = entry->size / 2;
+	selected = entry->offset + (slot == 'B' ? span : 0);
+	if ((entry->size & 1) || span < sizeof(struct ota_slot_meta) ||
+	    span % sizeof(struct ota_slot_meta) ||
+	    selected > (uint64_t)~0UL ||
+	    !k230_mmc_range_valid(selected, sizeof(struct ota_slot_meta)) ||
+	    pblk_desc->blksz != sizeof(struct ota_slot_meta) ||
+	    selected % pblk_desc->blksz) {
+		printf("K230 boot: invalid ota_meta layout for slot %c\n", slot);
+		return -1;
+	}
+
+	*offset = (ulong)selected;
+	return 0;
+}
