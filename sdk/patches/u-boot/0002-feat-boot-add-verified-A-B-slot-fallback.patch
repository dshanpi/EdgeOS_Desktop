+static int k230_write_meta_block(ulong offset,
+				 const struct ota_slot_meta *meta)
+{
+#if defined(CONFIG_MMC)
+	struct ota_slot_meta *write_buf;
+	struct ota_slot_meta *verify_buf;
+	ulong scratch;
+	lbaint_t sector;
+
+	if (!meta || !k230_boot_uses_mmc() ||
+	    pblk_desc->blksz != sizeof(*meta) ||
+	    offset % pblk_desc->blksz ||
+	    !k230_mmc_range_valid(offset, sizeof(*meta)))
+		return -1;
+
+	scratch = k230_get_encrypted_image_load_addr();
+	write_buf = (struct ota_slot_meta *)scratch;
+	verify_buf = (struct ota_slot_meta *)(scratch + sizeof(*meta));
+	memcpy(write_buf, meta, sizeof(*meta));
+	flush_cache((ulong)write_buf, sizeof(*write_buf));
+
+	sector = offset / pblk_desc->blksz;
+	if (blk_dwrite(pblk_desc, sector, 1, write_buf) != 1) {
+		printf("%s: write meta block fail, off=0x%lx\n",
+		       __func__, offset);
+		return -1;
+	}
+	memset(verify_buf, 0, sizeof(*verify_buf));
+	if (blk_dread(pblk_desc, sector, 1, verify_buf) != 1 ||
+	    memcmp(write_buf, verify_buf, sizeof(*write_buf))) {
+		printf("%s: meta readback mismatch, off=0x%lx\n",
+		       __func__, offset);
+		return -1;
+	}
+
+	return 0;
+#else
+	return -1;
 #endif
