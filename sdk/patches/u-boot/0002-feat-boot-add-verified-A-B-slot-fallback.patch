+static bool k230_boot_uses_mmc(void)
+{
+#if defined(CONFIG_MMC)
+	return (g_boot_medium == BOOT_MEDIUM_SDIO0) ||
+	       (g_boot_medium == BOOT_MEDIUM_SDIO1);
+#else
+	return false;
+#endif
+}
+
+static bool k230_mmc_range_valid(uint64_t offset, uint64_t size)
+{
+	uint64_t capacity;
+
+	if (!k230_boot_uses_mmc() || !pblk_desc || !pblk_desc->blksz ||
+	    !pblk_desc->lba || !size ||
+	    pblk_desc->lba > (~(uint64_t)0 / pblk_desc->blksz))
+		return false;
+
+	capacity = (uint64_t)pblk_desc->lba * pblk_desc->blksz;
+	return offset < capacity && size <= capacity - offset;
+}
