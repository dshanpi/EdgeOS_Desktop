From 13aef76bceb7bd85bf73d7912080ce74c69dfee7 Mon Sep 17 00:00:00 2001
From: Ubuntu <ubuntu@ubuntu2004.linuxvmimages.local>
Date: Mon, 24 Aug 2026 00:08:39 -0400
Subject: [PATCH 4/5] feat(kconfig): allow product LVGL with CanMV

---
 3rd-party/Kconfig | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/3rd-party/Kconfig b/3rd-party/Kconfig
index 2b12f5534bea39b9c5c824070cca44776062e4ff..a11be7b22249502cfc2245824c717f80f2cd60f9 100644
--- a/3rd-party/Kconfig
+++ b/3rd-party/Kconfig
@@ -13,10 +13,19 @@ menu "RT-Smart 3rd-party Configuration"
         bool "Enable Build FreeType"
         default y
 
+    config RTSMART_3RD_PARTY_ALLOW_LVGL_WITH_CANMV
+        bool "Allow RT-Smart LVGL alongside CanMV"
+        default n
+        depends on SDK_ENABLE_CANMV
+        help
+            Allow a product image to build the RT-Smart user-space LVGL
+            library while also including CanMV. Keep this disabled unless the
+            product owns display and memory coordination between both stacks.
+
     menuconfig RTSMART_3RD_PARTY_ENABLE_LVGL
         bool "Enable Build LVGL"
         default y
-        depends on !SDK_ENABLE_CANMV
+        depends on !SDK_ENABLE_CANMV || RTSMART_3RD_PARTY_ALLOW_LVGL_WITH_CANMV
 
         if RTSMART_3RD_PARTY_ENABLE_LVGL
             choice
