+/*
+ * The kernel driver timestamps reports with rt_tick_get(), while LVGL uses
+ * utils_cpu_ticks_ms().  Both advance at 1 kHz, but they do not promise the
+ * same zero point.  Learn the smallest observed offset (the sample with the
+ * least queueing delay) and translate controller timestamps into LVGL's
+ * clock domain.  This preserves the real spacing between queued MOVE reports
+ * without feeding LVGL timestamps from a different epoch.
+ */
+static uint32_t normalize_event_tick(lv_k230_touch_context_t* context,
+                                     uint32_t driver_tick,
+                                     uint32_t lvgl_now)
+{
+    /* Relearn the two clock epochs after a long input idle.  Besides handling
+     * clock drift, this keeps wrap-safe signed ordering comparisons inside a
+     * small, well-defined time window. */
+    if (context->timestamp_offset_valid &&
+        (uint32_t)(lvgl_now - context->last_mapping_activity_tick) > 60000U) {
+        context->timestamp_offset_valid = false;
+        context->normalized_event_tick_valid = false;
+    }
+    context->last_mapping_activity_tick = lvgl_now;
+
+    if (driver_tick == 0 && !context->timestamp_offset_valid) {
+        return lvgl_now;
+    }
+
+    uint32_t candidate_offset = lvgl_now - driver_tick;
+    if (!context->timestamp_offset_valid ||
+        (int32_t)(candidate_offset - context->timestamp_offset) < 0) {
+        context->timestamp_offset = candidate_offset;
+        context->timestamp_offset_valid = true;
+    }
+
+    uint32_t normalized = driver_tick + context->timestamp_offset;
+    if (tick_is_before(lvgl_now, normalized)) {
+        normalized = lvgl_now;
+    }
+    /* Lowering the learned queue-latency offset must never make LVGL time go
+     * backwards.  lv_tick_diff() is unsigned, so a single regression would
+     * otherwise look like a multi-week long press and corrupt scroll throw. */
+    if (context->normalized_event_tick_valid &&
+        tick_is_before(normalized, context->last_normalized_event_tick)) {
+        normalized = context->last_normalized_event_tick;
+    }
+    context->last_normalized_event_tick = normalized;
+    context->normalized_event_tick_valid = true;
+    return normalized;
+}
