+        lv_k230_touch_clamp(indev, &x, &y);
+
+        /* Some ST7701 touch controllers emit two or three complete DOWN/UP
+         * pairs for one stationary physical tap. Once the first tap has been
+         * released, discard only same-position pairs during the short bounce
+         * window. Different keys remain immediately responsive. */
+        if (context->suppressing_bounce &&
+            tick_is_before(event_tick,
+                           context->tap_bounce_block_until) &&
+            abs(x - context->last_tap_x) <=
+                LV_K230_TOUCH_TAP_BOUNCE_DISTANCE &&
+            abs(y - context->last_tap_y) <=
+                LV_K230_TOUCH_TAP_BOUNCE_DISTANCE) {
+#if LV_K230_TOUCH_DEBUG
+            printf("[touch-debug] bounce continuation event=%u raw=(%d,%d) "
