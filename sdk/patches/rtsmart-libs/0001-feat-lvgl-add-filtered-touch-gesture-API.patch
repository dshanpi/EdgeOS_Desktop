+#endif
+            if (point->event == DRV_TOUCH_EVENT_UP)
+                context->suppressing_bounce = false;
+            data->state = LV_INDEV_STATE_RELEASED;
+            data->point.x = context->last_x;
+            data->point.y = context->last_y;
+            context->last_state = LV_INDEV_STATE_RELEASED;
+            return;
         }
+        context->suppressing_bounce = false;
+        if ((point->event == DRV_TOUCH_EVENT_DOWN ||
+             point->event == DRV_TOUCH_EVENT_MOVE) &&
+            previous_state == LV_INDEV_STATE_RELEASED &&
+            tick_is_before(event_tick,
+                           context->tap_bounce_block_until) &&
+            abs(x - context->last_tap_x) <=
+                LV_K230_TOUCH_TAP_BOUNCE_DISTANCE &&
+            abs(y - context->last_tap_y) <=
+                LV_K230_TOUCH_TAP_BOUNCE_DISTANCE) {
+            context->suppressing_bounce = true;
+#if LV_K230_TOUCH_DEBUG
+            printf("[touch-debug] bounce DOWN suppressed final=(%d,%d) "
+                   "last-tap=(%d,%d) tick=%u deadline=%u\n",
+                   x, y, context->last_tap_x, context->last_tap_y,
+                   (unsigned)data->timestamp,
+                   (unsigned)context->tap_bounce_block_until);
+#endif
+            context->pending_release = false;
+            context->pending_release_event_tick = 0;
+            context->last_state = LV_INDEV_STATE_RELEASED;
+            data->state = LV_INDEV_STATE_RELEASED;
+            data->point.x = context->last_x;
+            data->point.y = context->last_y;
+            return;
+        }
+
+        if ((point->event == DRV_TOUCH_EVENT_DOWN ||
+             point->event == DRV_TOUCH_EVENT_MOVE) &&
+            previous_state == LV_INDEV_STATE_RELEASED) {
+            context->active_track_id = point->track_id;
+            reset_filter(context, x, y);
+            context->gesture_start_x = x;
+            context->gesture_start_y = y;
+            context->gesture_moved = false;
+            context->gesture_blocked =
+                tick_is_before(data->timestamp,
+                               context->suppress_click_until);
+        } else if ((point->event == DRV_TOUCH_EVENT_DOWN ||
+                    point->event == DRV_TOUCH_EVENT_MOVE) &&
+                   previous_state == LV_INDEV_STATE_PRESSED) {
+            context->pending_release = false;
+            context->pending_release_event_tick = 0;
+            filter_point(context, &x, &y);
+            int32_t dx = abs(x - context->gesture_start_x);
+            int32_t dy = abs(y - context->gesture_start_y);
+            if (dx >= LV_K230_TOUCH_DRAG_THRESHOLD ||
+                dy >= LV_K230_TOUCH_DRAG_THRESHOLD) {
+                context->gesture_moved = true;
+            }
+        } else if (point->event == DRV_TOUCH_EVENT_UP &&
+                   previous_state == LV_INDEV_STATE_PRESSED) {
+            /* The UP coordinate is often the noisiest sample. Keep the last
