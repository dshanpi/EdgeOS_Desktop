-        /* Use timestamp from touch driver if available */
-        if (point->timestamp != 0) {
-            data->timestamp = point->timestamp;
+        lv_k230_touch_compensate_lvgl_rotation(indev, &x, &y);
+#if LV_K230_TOUCH_DEBUG
+        int32_t compensated_x = x;
+        int32_t compensated_y = y;
+#endif
+
+#if defined(CONFIG_BOARD_K230_CANMV_DONGSHANPI)
+        lv_k230_touch_apply_board_mounting(indev, &x, &y);
