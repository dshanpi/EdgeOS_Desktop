From 2f1515d279b67dff5259c30fd2f0eda87041d21d Mon Sep 17 00:00:00 2001
From: Ubuntu <ubuntu@ubuntu2004.linuxvmimages.local>
Date: Mon, 24 Aug 2026 00:19:13 -0400
Subject: [PATCH] feat(tjpgd): enable native thumbnail scaling

---
 src/libs/tjpgd/tjpgd.c    | 26 ++++++++++++++++++++++++++
 src/libs/tjpgd/tjpgdcnf.h |  3 +--
 2 files changed, 27 insertions(+), 2 deletions(-)

diff --git a/src/libs/tjpgd/tjpgd.c b/src/libs/tjpgd/tjpgd.c
index 7152adf175114b215c677f7a88993d68eb8cde9c..1b394c03174e35e6260da390b037c7867a63122f 100644
--- a/src/libs/tjpgd/tjpgd.c
+++ b/src/libs/tjpgd/tjpgd.c
@@ -26,6 +26,10 @@
 
 #include "tjpgd.h"
 
+#if !JD_USE_SCALE
+#error "Gallery thumbnails require TJpgDec native scaling"
+#endif
+
 #if LV_USE_TJPGD
 
 #if JD_FASTDECODE == 2
@@ -889,6 +893,28 @@ JRESULT jd_mcu_output(
             }
         }
     }
+    else {      /* For only 1/8 scaling: each 8x8 block collapses to its DC value */
+        pix = (uint8_t *)jd->workbuf;
+        pc = jd->mcubuf + mx * my;
+        cb = pc[0] - 128;       /* Get Cb/Cr component and restore right level */
+        cr = pc[64] - 128;
+        for(iy = 0; iy < my; iy += 8) {
+            py = jd->mcubuf;
+            if(iy == 8) py += 64 * 2;
+            for(ix = 0; ix < mx; ix += 8) {
+                yy = *py;   /* Get Y component (DC value of the block) */
+                py += 64;
+                if(JD_FORMAT != 2) {
+                    *pix++ = /*B*/ BYTECLIP(yy + ((int)(1.772 * CVACC) * cb) / CVACC);
+                    *pix++ = /*G*/ BYTECLIP(yy - ((int)(0.344 * CVACC) * cb + (int)(0.714 * CVACC) * cr) / CVACC);
+                    *pix++ = /*R*/ BYTECLIP(yy + ((int)(1.402 * CVACC) * cr) / CVACC);
+                }
+                else {
+                    *pix++ = yy;
+                }
+            }
+        }
+    }
 
     /* Squeeze up pixel table if a part of MCU is to be truncated */
     mx >>= jd->scale;
diff --git a/src/libs/tjpgd/tjpgdcnf.h b/src/libs/tjpgd/tjpgdcnf.h
index dc27d6a959b8fce85354ba55ce20d99641e6160f..b3d8934bd0ae5be712747ee1aae5fea4ef7e6b6c 100644
--- a/src/libs/tjpgd/tjpgdcnf.h
+++ b/src/libs/tjpgd/tjpgdcnf.h
@@ -12,7 +12,7 @@
 /  2: Grayscale (8-bit/pix)
 */
 
-#define JD_USE_SCALE    0
+#define JD_USE_SCALE    1
 /* Switches output descaling feature.
 /  0: Disable
 /  1: Enable
@@ -30,4 +30,3 @@
 /  1: + 32-bit barrel shifter. Suitable for 32-bit MCUs.
 /  2: + Table conversion for huffman decoding (wants 6 << HUFF_BIT bytes of RAM)
 */
-
