# Keep large runtime assets out of normal Git object history.
*.kmodel filter=lfs diff=lfs merge=lfs -text
*.model  filter=lfs diff=lfs merge=lfs -text
*.bin    filter=lfs diff=lfs merge=lfs -text
*.elf    filter=lfs diff=lfs merge=lfs -text
*.a      filter=lfs diff=lfs merge=lfs -text
*.ttf    filter=lfs diff=lfs merge=lfs -text
*.otf    filter=lfs diff=lfs merge=lfs -text
*.bgra   filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text

# Source and scripts always use LF in the public repository.
*.c      text eol=lf
*.cc     text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.hpp    text eol=lf
*.cmake  text eol=lf
*.sh     text eol=lf
Makefile text eol=lf
*.md     text eol=lf
